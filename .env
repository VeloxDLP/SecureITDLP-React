# ── PlanetGuard UESM — Environment Variables ──────────────────────
#
# Your Spring Boot backend base URL (no trailing slash, no /api suffix)
VITE_API_BASE_URL=http://192.168.0.41:9292/SecureIT
# VITE_API_BASE_URL=http://192.168.0.86:9292/SecureIT
# VITE_API_BASE_URL=http://192.168.0.44:8080

# Set to 'false' to use the real backend API instead of mock data
# Set to 'true' (or remove) to use mock data
# VITE_USE_MOCK=true
VITE_USE_MOCK=false